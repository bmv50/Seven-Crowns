# Секреты и конфиги
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Локальные данные/логи
*.log
saves.json

# Кэш симуляций (воспроизводится sim_rules2.py)
.sim_rules2_cache.json

# Арты игры коммитятся: без них бот на сервере показывает голый текст, а
# воспроизвести их в CI или на VPS нельзя: генерация там не запускается.
# В репозиторий едут локации и мобы в JPEG и предметы в прозрачном WebP.
# Новые items_v2 созданы встроенным imagegen с настоящим альфа-каналом;
# scripts/optimize_item_art.py только уменьшает их и сохраняет прозрачность.
# Исходные PNG генераторов остаются локально: они не нужны в рантайме.
images/**/*.png
!images/**/*.jpg
!images/**/*.webp
# Кэш карточек предметов собирается ботом на лету
images/items_cache/

# Редакторы
.vscode/
.idea/
*.swp

# ОС
.DS_Store
Thumbs.db

# Рантайм-данные dev-режима (в проде живут в PostgreSQL)
guilds.json
auction.json
territory.json

# Кэши инструментов анализа/тестов (воспроизводимы)
graphify-out/
.pytest_cache/

# Артефакт-папка "~" (случайно созданная, не код проекта)
~/

# Дампы БД (создаются scripts/backup.sh и compose-контейнером backup)
backups/

# Go-референс TeleMud: лицензия неизвестна — не публикуем в открытый репозиторий.
# Если захочешь включить его в репо, убери строку ниже, проверив происхождение.
TeleMud/

# Private MAX legal drafts: owner did not authorize public publication.
docs/legal/README.md
docs/legal/MAX_TERMS.md
docs/legal/MAX_PRIVACY.md
docs/legal/MAX_RULES.md
docs/legal/MAX_PAYMENTS.md
docs/legal/MAX_PUBLICATION.md
docs/legal/max-site/
