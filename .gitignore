# Секреты и конфиги
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Локальные данные/логи
*.log
saves.json

# Кэш симуляций (воспроизводится sim_rules2.py)
.sim_rules2_cache.json

# Арты игры коммитятся: без них бот на сервере показывает голый текст, а
# воспроизвести их из скриптов может только владелец — генерация идёт на
# локальной видеокарте через ComfyUI, в CI и на VPS её нет.
# В репозиторий едут локации и мобы в JPEG (scripts/optimize_images.py) и
# спрайты предметов в WebP с прозрачностью (scripts/cutout_items.py — фон снят,
# иначе он виден прямоугольником на подложке карточки). Исходные PNG от ComfyUI
# весят 300+ МБ и не нужны.
images/**/*.png
!images/**/*.jpg
!images/**/*.webp
# Кэш карточек предметов собирается ботом на лету
images/items_cache/

# Редакторы
.vscode/
.idea/
*.swp

# ОС
.DS_Store
Thumbs.db

# Рантайм-данные dev-режима (в проде живут в PostgreSQL)
guilds.json
auction.json
territory.json

# Кэши инструментов анализа/тестов (воспроизводимы)
graphify-out/
.pytest_cache/

# Артефакт-папка "~" (случайно созданная, не код проекта)
~/

# Дампы БД (создаются scripts/backup.sh и compose-контейнером backup)
backups/

# Go-референс TeleMud: лицензия неизвестна — не публикуем в открытый репозиторий.
# Если захочешь включить его в репо, убери строку ниже, проверив происхождение.
TeleMud/

